    "@material-ui/icons": "^4.11.2",
    "@material-ui/lab": "^4.0.0-alpha.58",
    "clsx": "^1.1.1",
    "cookie": "^0.7.2",
    "graphql": "^15.5.0",
    "graphql-request": "^3.7.0",
    "graphql-tag": "^2.12.6",
    "lodash": "^4.18.1",
    "next": "10.2.3",
    "next-auth": "^3.26.1",
    "next-i18next": "^12.1.0",
    "react": "17.0.2",
